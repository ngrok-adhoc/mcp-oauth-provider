NGROK_AUTHTOKEN=

# Required. Exact Google emails and slash-delimited RE2 patterns.
USERS='["you@example.com"]'
# USERS='["you@example.com","/[^@]+@example\\.org/"]'

# Requests to /reg, /auth and /auth/* per minute, per client IP at each ngrok ingress server.
# OAUTH_REQUESTS_PER_MINUTE=30

# Authenticated requests to /mcp per minute, per user at each ngrok ingress server.
# MCP_REQUESTS_PER_MINUTE=60

# Required. Set your existing HTTP MCP endpoint, including its path.
# Example: http://127.0.0.1:3001/mcp
MCP_SERVER_URL=

# Set for an ngrok internal endpoint in the provider's account; use a .internal URL ending in /mcp.
# MCP_SERVER_BINDING=internal

# Optional branding on the OAuth consent page.
# MCP_SERVER_NAME=Bowie
# MCP_SERVER_ICON=./bowie.png

# Optional published OAuth identities for hosted Claude and Codex.
# CLAUDE_CIMD=1

# Optional web app origin; not required for MCP connections.
# APP_URL=http://127.0.0.1:3000

# Set a fixed URL to keep existing OAuth connections across provider restarts.
# Omit to use ngrok's automatically allocated URL.
# NGROK_URL=https://your-assigned-dev-domain.ngrok-free.app

# OAuth storage defaults to local JSON unless an S3 bucket and credentials are available.
# STORAGE=local
# STORAGE=s3
# AWS_REGION=ap-southeast-2
# S3_BUCKET=your-private-bucket
# S3_KEY=mcp-oauth-provider/oauth.json
# S3_BUCKET_OWNER=123456789012
