{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noEmitOnError": true
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts", "lib/**/*.tsx"]
}
